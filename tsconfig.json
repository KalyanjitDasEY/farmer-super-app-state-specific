{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-production/types/**/*.ts",
    ".next-production/dev/types/**/*.ts",
    ".next-e2e-root/types/**/*.ts",
    ".next-e2e-root/dev/types/**/*.ts",
    ".next-e2e-base/types/**/*.ts",
    ".next-e2e-base/dev/types/**/*.ts",
    ".next-crop-check/types/**/*.ts",
    ".next-crop-check/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next-e2e", ".next-e2e-root", ".next-e2e-base"]
}
